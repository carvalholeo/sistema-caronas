{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "models/*": ["src/models/*"],
      "routes/*": ["src/routes/*"],
      "middlewares/*": ["src/middlewares/*"],
      "providers/*": ["src/providers/*"],
      "services/*": ["src/services/*"],
      "types/*": ["src/types/*"],
      "utils/*": ["src/utils/*"],
      "config/*": ["src/config/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}