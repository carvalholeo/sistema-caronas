{
  "name": "carpool-backend",
  "version": "1.0.0-alpha.10",
  "description": "Backend for the Carpool System, implementing robust authentication, user management, ride management, and real-time communication.",
  "main": "dist/server.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json && copyfiles -u 1 \"src/services/templates/**/*.hbs\" dist",
    "dev": "nodemon",
    "dev:debug": "nodemon --inspect=0.0.0.0:9229",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration --runInBand --passWithNoTests",
    "test:mutation": "stryker run",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose up --build",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f app",
    "docker:shell": "docker-compose -f docker-compose.dev.yml exec app sh",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:seed": "ts-node src/scripts/seed.ts",
    "prepare": "husky",
    "precommit": "lint-staged",
    "format:code:check": "prettier --check src/**/*.ts",
    "format:code:fix": "prettier --write src/**/*.ts",
    "format:doc:check": "prettier --check ./**/*.md",
    "format:doc:fix": "prettier --write ./**/*.md",
    "version:bump": "node scripts/version-bump.js",
    "version:bump:commit": "node scripts/version-bump.js --commit --changelog",
    "version:check": "node -e \"console.log('Current version:', require('./package.json').version)\"",
    "changelog:init": "node scripts/changelog-generator.js init",
    "changelog:add": "node scripts/changelog-generator.js add",
    "changelog:add:auto": "node scripts/changelog-generator.js add --auto",
    "changelog:validate": "node scripts/changelog-generator.js validate",
    "precommit:version": "node scripts/check-version-rules.js",
    "precommit:changelog": "npm run changelog:validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.1",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "node-apn-flitto": "^4.1.3",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "validator": "^13.15.15",
    "web-push": "^3.6.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@stryker-mutator/api": "^9.1.0",
    "@stryker-mutator/core": "^9.1.0",
    "@stryker-mutator/jest-runner": "^9.1.1",
    "@stryker-mutator/typescript-checker": "^9.1.0",
    "@stryker-mutator/util": "^9.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.0",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.5",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "redis-memory-server": "^0.13.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0"
  },
  "keywords": [
    "carpool",
    "backend",
    "nodejs",
    "typescript",
    "express"
  ],
  "author": "Your Name",
  "license": "LICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "filepath": "./src/**/*.ts"
  }
}
